# .shellcheckrc — repo-local shellcheck configuration
#
# RetroPie-Sunvox vendors sunvox.sh, a RetroPie scriptmodule. It uses the
# rp_module framework, whose globals ($romdir, $md_inst, $md_build, $es_settings,
# etc.) are provided at runtime and not visible to shellcheck. We fix the
# genuine issues in-tree and disable the framework/style false positives here
# so .github/workflows/ci.yml stays green without rewriting working code.
#
# Framework-provided globals (false positives):
disable=SC2154  # var referenced but not assigned (rp_module global)
disable=SC2034  # var assigned but not used (framework / intentional)
# Style / intentional constructs:
disable=SC2069  # 2>&1 must be last — intentional redirection order
disable=SC2206  # split command output into array — intentional
disable=SC2207  # mapfile vs split — style
disable=SC2116  # echo to pipe / command substitution — intentional
disable=SC2027  # quoted? — intentional in dialog strings
